{
  "name": "@signaledi/mcp-server",
  "version": "0.5.0",
  "mcpName": "io.github.SignalEDI/mcp-server",
  "description": "SignalEDI developer MCP server for X12 guidance, synthetic fixtures, governed connections, and profile-gated REST API workflows.",
  "license": "MIT",
  "author": "SignalEDI",
  "homepage": "https://signaledi.com/developers/pricing#mcp",
  "bugs": {
    "url": "https://github.com/SignalEDI/mcp-server/issues",
    "email": "Support@signaledi.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SignalEDI/mcp-server.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "bin": {
    "signaledi-mcp": "src/index.mjs"
  },
  "main": "src/index.mjs",
  "files": [
    "src",
    "examples",
    "LICENSE",
    "MIRROR.md",
    "README.md",
    "RELEASE_NOTES_0.5.0.md",
    "server.json",
    "stdio-smoke.mjs",
    "test.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "validate:cursor-plugin": "node scripts/validate-cursor-plugin.mjs",
    "test": "node test.mjs",
    "test:stdio": "node stdio-smoke.mjs && node stdio-smoke.mjs sandbox && node stdio-smoke.mjs production",
    "verify": "npm run validate:release && npm run validate:cursor-plugin && npm test && npm run test:stdio && npm pack --dry-run && node consumer-install-smoke.mjs"
  },
  "keywords": [
    "edi",
    "x12",
    "mcp",
    "model-context-protocol",
    "signaledi",
    "ai",
    "claude",
    "cursor",
    "850",
    "810",
    "856",
    "quickbooks",
    "qbo",
    "accounting"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0"
  }
}
